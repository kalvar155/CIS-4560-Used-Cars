DROP TABLE IF EXISTS used_cars_narrow;
CREATE EXTERNAL TABLE used_cars_narrow AS
SELECT
    body_type,
    exterior_color,
    franchise_make,
    fuel_type,
    interior_color,
    listing_color,
    make_name,
    CAST(price AS DECIMAL(10, 2)), -- Casting to a numerical type for analysis
    wheel_system,
    CAST(year AS INT)             -- Casting to an integer type for analysis
FROM
    used_cars_full;

SELECT * FROM used_cars_narrow LIMIT 5;

-- Average price by make
SELECT make_name, AVG(price) AS avg_price
FROM used_cars_narrow
GROUP BY make_name
ORDER BY avg_price DESC
LIMIT 10;

--  Count of cars by body type
SELECT body_type, COUNT(*) AS num_cars
FROM used_cars_narrow
GROUP BY body_type
ORDER BY num_cars DESC;

-- Distribution of fuel types
SELECT fuel_type, COUNT(*) AS num_cars
FROM used_cars_narrow
GROUP BY fuel_type;

-- Used car listings
SELECT
    year,
    COUNT(*) AS num_listings
FROM
    used_cars_narrow
GROUP BY
    year
ORDER BY
    year;
	
--Frequently listed car brands
SELECT
    make_name,
    COUNT(*) AS num_listings
FROM
    used_cars_narrow
GROUP BY
    make_name
ORDER BY
    num_listings DESC
LIMIT 10;

-- Common exterior colors
SELECT
    exterior_color,
    COUNT(*) AS num_listings
FROM
    used_cars_narrow
GROUP BY
    exterior_color
ORDER BY
    num_listings DESC
LIMIT 10; -- You can adjust the LIMIT to see more or fewer colors

